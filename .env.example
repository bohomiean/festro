# Copy this file to .env.local and fill in the values.

# Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=the url of supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=the public key

# Optional: turns on the AI chatbot. Without it, FestMate uses its built-in keyword answers.
# Get a key at https://console.anthropic.com. Keep it secret: never prefix it with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
# Optional: override the model
ANTHROPIC_MODEL=claude-haiku-5-5
